#!/usr/bin/env python3
"""hb, one HeroBench action per call, for an agent playing action by action.

    ./hb <command> [arguments]

Stdlib only. Each call sends one request to the HeroBench environment server and
prints the server's JSON answer verbatim, so the tool result the harness records
carries the environment's answer whole. The exit status is 0 for a 2xx answer and 1
otherwise, the answer printed either way. Usage errors print the usage and exit 2.

The server and the character come from `hb.conf` beside this file, a JSON object
with `url` and `character`, because the gate's shell runs with only HOME set and
the agent has one character on one server.
"""
import json
import os
import sys
import urllib.error
import urllib.request

USAGE = """usage: ./hb <command> [arguments]
actions:
  move X Y              move one tile, to a tile at most one step away in x and in y
  fight                 fight the monster on your tile
  gather [N]            gather the resource on your tile, N times (default 1)
  craft CODE N          craft N of item CODE at the matching workshop
  buy CODE N            buy N of item CODE at the Grand Exchange
  equip SLOT CODE       equip item CODE in SLOT
  unequip SLOT          unequip the item in SLOT
queries:
  character             your character: position, levels, hp, equipment, inventory
  map X Y               what stands on tile X Y
  item CODE             an item, with its recipe
  monster CODE          a monster, with its stats and drops
  resource CODE         a resource, with its skill, level and drops
slots: weapon shield helmet body_armor leg_armor boots ring1 ring2 amulet
       artifact1 artifact2 artifact3 consumable1 consumable2"""


def config():
    with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "hb.conf")) as fh:
        conf = json.load(fh)
    return conf["url"].rstrip("/"), conf["character"]


def call(method, url, body=None):
    data = None if body is None else json.dumps(body).encode()
    request = urllib.request.Request(url, data=data, method=method)
    if data is not None:
        request.add_header("Content-Type", "application/json")
    try:
        with urllib.request.urlopen(request, timeout=60) as response:
            return response.status, response.read()
    except urllib.error.HTTPError as error:
        return error.code, error.read()


def integer(text):
    try:
        return int(text)
    except ValueError:
        usage()


def usage():
    print(USAGE, file=sys.stderr)
    sys.exit(2)


def main(argv):
    if not argv:
        usage()
    base, name = config()
    act = f"{base}/my/{name}/action"
    command, args = argv[0], argv[1:]
    routes = {
        ("move", 2): lambda: ("POST", f"{act}/move", {"x": integer(args[0]), "y": integer(args[1])}),
        ("fight", 0): lambda: ("POST", f"{act}/fight", None),
        ("gather", 0): lambda: ("POST", f"{act}/gathering", 1),
        ("gather", 1): lambda: ("POST", f"{act}/gathering", integer(args[0])),
        ("craft", 2): lambda: ("POST", f"{act}/crafting", {"code": args[0], "quantity": integer(args[1])}),
        ("buy", 2): lambda: ("POST", f"{act}/buy", {"code": args[0], "quantity": integer(args[1])}),
        ("equip", 2): lambda: ("POST", f"{act}/equip", {"slot": args[0], "code": args[1], "quantity": 1}),
        ("unequip", 1): lambda: ("POST", f"{act}/unequip", {"slot": args[0], "quantity": 1}),
        ("character", 0): lambda: ("GET", f"{base}/characters/{name}", None),
        ("map", 2): lambda: ("GET", f"{base}/maps/{integer(args[0])}/{integer(args[1])}", None),
        ("item", 1): lambda: ("GET", f"{base}/items/{args[0]}", None),
        ("monster", 1): lambda: ("GET", f"{base}/monsters/{args[0]}", None),
        ("resource", 1): lambda: ("GET", f"{base}/resources/{args[0]}", None),
    }
    route = routes.get((command, len(args)))
    if route is None:
        usage()
    method, url, body = route()
    status, answer = call(method, url, body)
    sys.stdout.write(answer.decode("utf-8", "replace") + "\n")
    return 0 if 200 <= status < 300 else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
